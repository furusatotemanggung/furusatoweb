# === Firebase (frontend — nilai dari Project settings > Your apps > Web app) ===
# Nilai-nilai ini memang tampil di bundle publik; keamanan dijaga Firestore Rules + Auth.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# === Function server (api/) — JANGAN pakai awalan REACT_APP_ ===
# Nilai sama dengan konfigurasi web di atas, untuk verifikasi token & baca Firestore.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=

# === Cloudinary (server saja — API SECRET tidak boleh masuk frontend/chat) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
